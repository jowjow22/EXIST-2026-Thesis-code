digraph G {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.3, ranksep=0.35, bgcolor="#fcfcfb", pad=0.2];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10.5, fillcolor="#ffffff", color="#52514e", margin="0.14,0.07"];
  edge  [color="#52514e", fontname="Helvetica", fontsize=9, fontcolor="#52514e"];
  meme [label="meme de treino\n(id_EXIST, lang,\nimagem, text)", fillcolor="#f1f0ec"];
  img  [label="imagem → base64\n(MIME pelo arquivo;\nSHA-256 gravado)"];
  txt  [label="text → pre_process_text\n(mesma limpeza\ndo modelo de memes)"];
  pr   [label="P1 / P2 / P3\n{text} substituído\n(SHA-256 de cada prompt)"];
  msg  [label="1 mensagem user,\nsem system prompt\npartes [imagem, texto]"];
  glm  [label="GLM · vLLM\nOpenAI-compatível\nseed 42, temp 0,1", color="#2a78d6", penwidth=1.6];
  cl   [label="Claude · Batches API\nthinking between_tools\neffort medium", color="#0f8f6a", penwidth=1.6];
  parse[label="parser (só content)\nbox → plain →\nsingle_token → ?"];
  jsonl[label="JSONL: 1 linha por chamada\n(params, hashes, resposta,\nusage, label, método)"];
  vote [label="por meme:\nvoto = maioria das 3\np = nº YES / 3\nconfiante = 3-0", fillcolor="#f1f0ec"];
  meme -> img; meme -> txt; txt -> pr; img -> msg; pr -> msg;
  msg -> glm; msg -> cl; glm -> parse; cl -> parse; parse -> jsonl -> vote;
}
