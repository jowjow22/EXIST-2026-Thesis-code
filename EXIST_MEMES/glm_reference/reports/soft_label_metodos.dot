digraph G {
  graph [rankdir=TB, fontname="Helvetica", nodesep=0.3, ranksep=0.45, bgcolor="white",
         label=<<B>Como o novo soft label é calculado</B><BR/><FONT POINT-SIZE="12">painel de exemplo (5 memes, 6 anotadores) com o padrão mais comum nos dados: o GLM diz YES na maioria dos memes</FONT>>,
         labelloc=t, fontsize=20];
  node [shape=plaintext, fontname="Helvetica", fontsize=12];
  edge [color="#666666", arrowsize=0.8];

  painel [label=<
  <TABLE BORDER="1" COLOR="#444444" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white">
   <TR><TD BGCOLOR="#eeeeee"><B>meme</B></TD><TD BGCOLOR="#eeeeee"><B>A</B></TD><TD BGCOLOR="#eeeeee"><B>B</B></TD><TD BGCOLOR="#eeeeee"><B>C</B></TD><TD BGCOLOR="#eeeeee"><B>D</B></TD><TD BGCOLOR="#eeeeee"><B>E</B></TD><TD BGCOLOR="#eeeeee"><B>F</B></TD><TD BGCOLOR="#eeeeee"><B>GLM</B> (P1 P2 P3)</TD><TD BGCOLOR="#eeeeee"><B>conta no desvio?</B></TD></TR>
   <TR><TD>m1</TD><TD BGCOLOR="#cfe8cf">YES</TD><TD BGCOLOR="#cfe8cf">YES</TD><TD BGCOLOR="#cfe8cf">YES</TD><TD BGCOLOR="#cfe8cf">YES</TD><TD BGCOLOR="#cfe8cf">YES</TD><TD BGCOLOR="#cfe8cf">YES</TD><TD>YES YES YES</TD><TD>não (todos iguais)</TD></TR>
   <TR><TD>m2</TD><TD BGCOLOR="#cfe8cf">YES</TD><TD BGCOLOR="#cfe8cf">YES</TD><TD BGCOLOR="#cfe8cf">YES</TD><TD BGCOLOR="#cfe8cf">YES</TD><TD BGCOLOR="#cfe8cf">YES</TD><TD BGCOLOR="#f4cccc">NO</TD><TD>YES YES YES</TD><TD>sim</TD></TR>
   <TR><TD BGCOLOR="#fff2b3"><B>m3</B></TD><TD BGCOLOR="#cfe8cf"><B>YES</B></TD><TD BGCOLOR="#f4cccc">NO</TD><TD BGCOLOR="#f4cccc">NO</TD><TD BGCOLOR="#f4cccc">NO</TD><TD BGCOLOR="#f4cccc">NO</TD><TD BGCOLOR="#f4cccc">NO</TD><TD>YES YES YES</TD><TD BGCOLOR="#fff2b3"><B>sim · meme em destaque</B></TD></TR>
   <TR><TD>m4</TD><TD BGCOLOR="#cfe8cf">YES</TD><TD BGCOLOR="#cfe8cf">YES</TD><TD BGCOLOR="#cfe8cf">YES</TD><TD BGCOLOR="#f4cccc">NO</TD><TD BGCOLOR="#f4cccc">NO</TD><TD BGCOLOR="#f4cccc">NO</TD><TD>YES YES NO</TD><TD>sim</TD></TR>
   <TR><TD>m5</TD><TD BGCOLOR="#cfe8cf">YES</TD><TD BGCOLOR="#cfe8cf">YES</TD><TD BGCOLOR="#cfe8cf">YES</TD><TD BGCOLOR="#cfe8cf">YES</TD><TD BGCOLOR="#f4cccc">NO</TD><TD BGCOLOR="#f4cccc">NO</TD><TD>YES YES YES</TD><TD>sim</TD></TR>
  </TABLE>>];

  peso [label=<
  <TABLE BORDER="1" COLOR="#444444" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#f7f7f7">
   <TR><TD COLSPAN="7"><B>1 · Peso de cada anotador</B> (um por ID, calculado sobre todos os memes dele)</TD></TR>
   <TR><TD COLSPAN="7" ALIGN="LEFT" BALIGN="LEFT">erro no meme: d = |voto − fração de YES do GLM|  ·  importância do meme: w = consenso dos OUTROS 5 (5-0 → 1 · 4-1 → 0,28 · 3-2 → 0,03)<BR ALIGN="LEFT"/>desvio D = média de d pesada por w  ·  peso r = 1 − D<BR ALIGN="LEFT"/></TD></TR>
   <TR><TD COLSPAN="7" ALIGN="LEFT" BALIGN="LEFT"><B>no m3:</B> A acerta (d = 0) e os outros 5 estão unânimes contra ele → w = <B>1</B>: crédito cheio para A<BR ALIGN="LEFT"/>           B…F erram (d = 1), mas os outros estão 4-1 → w = <B>0,28</B>: punição pequena para cada um<BR ALIGN="LEFT"/></TD></TR>
   <TR><TD></TD><TD><B>A</B></TD><TD><B>B</B></TD><TD><B>C</B></TD><TD><B>D</B></TD><TD><B>E</B></TD><TD><B>F</B></TD></TR>
   <TR><TD ALIGN="LEFT">r</TD><TD><B>0,99</B></TD><TD>0,53</TD><TD>0,53</TD><TD>0,52</TD><TD>0,33</TD><TD>0,01</TD></TR>
   <TR><TD ALIGN="LEFT">r⁴</TD><TD><B>0,97</B></TD><TD>0,08</TD><TD>0,08</TD><TD>0,07</TD><TD>0,01</TD><TD>0,00</TD></TR>
  </TABLE>>];

  c1 [label=<
  <TABLE BORDER="2" COLOR="#1f77b4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white">
   <TR><TD BGCOLOR="#dbe9f6"><B>Ponderação pelo GLM</B> · peso r</TD></TR>
   <TR><TD>p = Σ r·YES / Σ r</TD></TR>
   <TR><TD>= 0,99 / (0,99 + 0,53 + 0,53 + 0,52 + 0,33 + 0,01)</TD></TR>
   <TR><TD><FONT POINT-SIZE="18"><B>m3: 0,17 → 0,34</B></FONT></TD></TR>
  </TABLE>>];

  c2 [label=<
  <TABLE BORDER="2" COLOR="#d62728" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white">
   <TR><TD BGCOLOR="#f8dcdc"><B>Ponderação extrema</B> · peso r⁴</TD></TR>
   <TR><TD>p = Σ r⁴·YES / Σ r⁴</TD></TR>
   <TR><TD>= 0,97 / (0,97 + 0,08 + 0,08 + 0,07 + 0,01 + 0,00)</TD></TR>
   <TR><TD><FONT POINT-SIZE="18"><B>m3: 0,17 → 0,80</B></FONT><BR/><FONT COLOR="#a00000">5 de 6 disseram NO, e o treino vê "sexista"</FONT></TD></TR>
  </TABLE>>];

  c3 [label=<
  <TABLE BORDER="2" COLOR="#2ca02c" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white">
   <TR><TD BGCOLOR="#dff0d8"><B>Mistura do GLM corrigido</B> (proposta)</TD></TR>
   <TR><TD>sem peso por anotador · GLM na escala humana (YES YES YES → 0,76)</TD></TR>
   <TR><TD>p = 0,5 · 0,17 + 0,5 · 0,76</TD></TR>
   <TR><TD><FONT POINT-SIZE="18"><B>m3: 0,17 → 0,46</B></FONT><BR/>controle sem GLM (0,5·0,17 + 0,5·0,555): 0,36</TD></TR>
  </TABLE>>];

  painel -> peso;
  peso -> c1; peso -> c2;
  painel -> c3 [style=dashed, color="#2ca02c"];
  { rank=same; c1; c2; c3; }
}
