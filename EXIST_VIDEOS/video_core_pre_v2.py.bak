# ============================================================================
# 1. Reprodutibilidade — seeds, determinismo e fingerprints
# ============================================================================

# O cuBLAS lê esta variável quando cria o handle (primeira operação em GPU); precisa
# estar definida antes de qualquer uso de CUDA para ter efeito. Fica no import, como
# em memes_core.py. As flags globais do torch NÃO ficam aqui — ver set_all_seeds.
os.environ["CUBLAS_WORKSPACE_CONFIG"] = ":4096:8"

# OPT-06 / 04_RECONCILIATION §6: duas seeds com papéis SEPARADOS.
#   SPLIT_SEED — define o conjunto de validação. FIXO. NUNCA muda, nunca é re-sorteado.
#                Re-sortear porque os números saíram feios é split-shopping.
#   INIT_SEED  — varia em {42, 7, 2025}: init dos pesos novos + ordem dos dados.
# Com o split fixo, as 9 runs (3 condições × 3 seeds) partilham exatamente o mesmo val
# e o delta por INIT_SEED é PAREADO — é a única forma compatível com o teste correto
# (delta por seed + consistência de sinal, nunca |Δmédia| > std).
SPLIT_SEED = 42
INIT_SEED = 42

VAL_FRACTION = 0.20   # OPT-11: 80/20 → ~505 amostras de val (era 90/10 → 253).
                      # Pré-requisito do ARCH-11(b): dividir o val em metades para o
                      # ajuste de limiar não é viável a 253 amostras.

# Portão do split (04_RECONCILIATION §6.3): nenhuma categoria da Task C pode ficar com
# contagem de positivos de um dígito no val candidato.
MIN_TASK_C_POSITIVES_VAL = 10


def set_all_seeds(seed: int):
    """Fixa todos os RNGs que afetam a reprodutibilidade e força kernels determinísticos.

    Chamar de novo imediatamente antes de cada passo cuja aleatoriedade precisa ser
    reproduzível (init do VideoMAE+LoRA, do XLM-R+LoRA e do EXISTVideoModel — as
    matrizes LoRA A são aleatórias) — re-zera os geradores para o mesmo ponto,
    independentemente do que rodou antes.

    As flags globais do torch são setadas AQUI e não no import: importar `video_core`
    a partir de um script de inferência não deve virar flags globais do processo.
    """
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)            # RNG da CPU (init de pesos, dropout em CPU)
    torch.cuda.manual_seed_all(seed)   # RNG de todas as GPUs (dropout em GPU)
    set_seed(seed)                     # RNG interno do HF (o Trainer o re-seeda tarde demais)

    # Sem isto, o cuDNN escolhe algoritmos por benchmark de tempo de execução (varia de
    # run para run) e a CUDA usa kernels com somas atômicas em ordem arbitrária —
    # diferenças de arredondamento que se amplificam ao longo das épocas.
    torch.backends.cudnn.benchmark = False
    torch.backends.cudnn.deterministic = True
    # Exige implementação determinística de TODO operador; levanta RuntimeError nomeando
    # o operador culpado, o que é melhor que irreprodutibilidade silenciosa.
    torch.use_deterministic_algorithms(True)


def model_fingerprint(model) -> str:
    """SHA-256 (16 hex) sobre todos os pesos — fingerprints iguais significam pesos
    bit a bit idênticos. Comparar entre runs verifica a reprodutibilidade.

    ⚠ Fingerprints só são comparáveis DENTRO do mesmo par (braço, INIT_SEED): braços
    diferentes criam módulos diferentes, em ordem diferente, com `fan_in` diferente na
    fusão → consomem RNG de forma diferente (04_RECONCILIATION §1.3).
    """
    digest = hashlib.sha256()
    for name, param in sorted(model.state_dict().items()):
        digest.update(name.encode())
        digest.update(param.detach().cpu().numpy().tobytes())
    return digest.hexdigest()[:16]


def record_fingerprint(run_dir, tag: str, model) -> str:
    """Persiste o fingerprint em `RUN_DIR/fingerprints.json` e compara com o valor já
    gravado para a mesma tag, se existir (ARCH-19).

    A verificação manual de fingerprints não escala para 9–12 runs desatendidas, e na
    run original a célula que faria a comparação automática nem chegou a rodar
    (ARCH-12). `tag` é tipicamente "init" ou "final".
    """
    run_dir = Path(run_dir)
    run_dir.mkdir(parents=True, exist_ok=True)
    path = run_dir / "fingerprints.json"

    current = model_fingerprint(model)
    previous = {}
    if path.exists():
        with open(path) as f:
            previous = json.load(f)

    if tag in previous:
        if previous[tag] == current:
            print(f"[fingerprint] {tag}: {current}  ✓ idêntico à run anterior")
        else:
            print(f"[fingerprint] {tag}: {current}  ✗ MISMATCH "
                  f"(run anterior: {previous[tag]}) — a run NÃO é reprodutível")
    else:
        print(f"[fingerprint] {tag}: {current}  (primeira run; nada a comparar)")

    previous[tag] = current
    with open(path, "w") as f:
        json.dump(previous, f, indent=2)
    return current


